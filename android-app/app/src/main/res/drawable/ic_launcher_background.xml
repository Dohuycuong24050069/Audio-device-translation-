<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark sleek radial glass background -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="40"
                android:gradientRadius="72"
                android:type="radial">
                <item android:color="#1A2744" android:offset="0.0" />
                <item android:color="#0B101D" android:offset="0.6" />
                <item android:color="#06080F" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer ambient subtle glow circle -->
    <path
        android:pathData="M54,18 A36,36 0 1,0 54,90 A36,36 0 1,0 54,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:type="linear">
                <item android:color="#333B82F6" android:offset="0.0" />
                <item android:color="#1A6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek thin glowing accent ring -->
    <path
        android:pathData="M54,22 A32,32 0 1,0 54,86 A32,32 0 1,0 54,22 Z"
        android:strokeWidth="1.2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86"
                android:type="linear">
                <item android:color="#8060A5FA" android:offset="0.0" />
                <item android:color="#20818CF8" android:offset="0.5" />
                <item android:color="#60A855F7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
