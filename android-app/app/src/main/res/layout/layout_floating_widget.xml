<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_card"
    android:padding="12dp">

    <!-- Header: drag handle + controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <!-- Brand & drag area -->
        <LinearLayout
            android:id="@+id/layoutDragHandle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Live dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot"
                android:backgroundTint="@color/status_ok"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE SUBTITLES"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- Control buttons -->
        <TextView
            android:id="@+id/btnSwapOverlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⇄"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/btnResizeOverlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⤢"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/btnCloseOverlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/status_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        android:layout_marginBottom="9dp" />

    <!-- Scrollable Subtitles Container -->
    <ScrollView
        android:id="@+id/scrollSubtitleArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Original transcript -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/tvOriginalTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EN"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:background="@drawable/bg_lang_tag"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvOriginalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/waiting_audio"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="8"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginVertical="8dp" />

            <!-- Row 2: Translated text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/tvTranslatedTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VI"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_accent"
                    android:background="@drawable/bg_lang_tag"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvTranslatedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bản dịch xuất hiện tại đây..."
                    android:textColor="@color/text_accent"
                    android:textSize="14sp"
                    android:maxLines="8"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Resize corner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/viewResizeCorner"
            android:layout_width="26dp"
            android:layout_height="20dp"
            android:gravity="end|bottom"
            android:text="⤡"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:paddingEnd="2dp" />
    </LinearLayout>

</LinearLayout>
